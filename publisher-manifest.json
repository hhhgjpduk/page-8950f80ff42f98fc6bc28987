ep,decimal-leading-zero);color:var(--cyan-d);font-size:15px;font-weight:600;letter-spacing:.06em}\nol.steps li h3{margin:0 0 6px;font-size:16px;font-weight:600}\nol.steps li p{margin:0;color:var(--slate-2);font-size:15px}\n\n/* clients */\n.clients p.intro{color:var(--slate-2);margin:0 0 18px}\n.clients .row{display:grid;grid-template-columns:1fr 1fr;gap:0;border-top:1px solid var(--line)}\n.clients .cell{padding:20px 0;border-bottom:1px solid var(--line)}\n.clients .cell:nth-child(odd){border-right:1px solid var(--line);padding-right:20px}\n.clients .cell:nth-child(even){padding-left:20px}\n.clients .cell h3{margin:0 0 6px;font-size:15px;font-weight:600}\n.clients .cell p{margin:0;color:var(--slate-2);font-size:14px}\n.clients .cell .link{margin-top:8px;font-size:13px}\n.clients .cell .link a{color:var(--mute)}\n\n/* faq numbered */\nol.faq{list-style:none;counter-reset:f;margin:0;padding:0}\nol.faq li{counter-increment:f;padding:22px 0;border-bottom:1px solid var(--line);display:grid;grid-template-columns:42px 1fr;gap:16px}\nol.faq li:last-child{border-bottom:none}\nol.faq li::before{content:counter(f,decimal-leading-zero);color:var(--cyan-d);font-size:14px;font-weight:600}\nol.faq li h3{margin:0 0 8px;font-size:16px;font-weight:600;color:var(--ink)}\nol.faq li p{margin:0;color:var(--slate-2);font-size:15px}\n\n/* footer */\nfooter{padding:48px 0 64px;background:var(--paper)}\nfooter .wrap{display:flex;flex-direction:column;gap:10px}\nfooter .name{font-weight:600;color:var(--ink);letter-spacing:.04em}\nfooter .note{font-size:13px;color:var(--mute);max-width:620px}\nfooter .links{display:flex;gap:18px;flex-wrap:wrap;margin-top:8px}\nfooter .links a{font-size:13px;color:var(--slate-2);border:none}\nfooter .copy{font-size:12px;color:var(--slate-3);margin-top:16px}\n\n@media (max-width:640px){\n  article.hero h1{font-size:26px}\n  article.hero .lede{font-size:16px}\n  ul.spec li{grid-template-columns:1fr;gap:4px}\n  ul.spec li .k{font-size:12px}\n  .plan ul.feat{grid-template-columns:1fr}\n  .plan.featured{margin:0 -12px;padding:22px 12px}\n  .clients .row{grid-template-columns:1fr}\n  .clients .cell:nth-child(odd){border-right:none;padding-right:0}\n  .clients .cell:nth-child(even){padding-left:0}\n  ol.faq li,ol.steps li{grid-template-columns:32px 1fr;gap:12px}\n  nav.bar .links{gap:14px}\n}\n</style><nav class=\"bar\">\n  <div class=\"wrap row\">\n    <a class=\"brand\" href=\"#top\">SIM</a>\n    <div class=\"links\">\n      <a href=\"#overview\">概览</a>\n      <a href=\"#plans\">套餐</a>\n      <a href=\"#usage\">使用说明</a>\n      <a href=\"#clients\">客户端</a>\n      <a href=\"#faq\">常见问题</a>\n    </div>\n  </div>\n</nav>\n\n<main id=\"top\">\n\n  <article class=\"hero\">\n    <div class=\"wrap\">\n      <div class=\"kicker\">SIM / 服务说明文档</div>\n      <h1>SIM 网络连接服务：按流量与设备规模分级的接入方案</h1>\n      <p class=\"lede\">SIM 以流量配额、设备并发数和线路规格作为核心变量，提供三档可对照的接入方案。本页内容用于在订阅前确认服务边界、使用方式与支持范围。</p>\n      <p class=\"body\">在正式启用前，请先核对所在网络环境对代理类连接的限制。SIM 不对特定地区可达性作出持续保证；线路规格、节点池组成和支持响应等级均以套餐说明为准。</p>\n      <p class=\"body\">以下说明按“服务概览 — 套餐规格 — 使用说明 — 客户端 — 常见问题”顺序排列，供查阅与留存。</p>\n      <div class=\"meta\">\n        <span>文档类型：服务说明</span>\n        <span>适用对象：个人与团队订阅用户</span>\n        <span>更新方式：按套餐版本同步</span>\n      </div>\n    </div>\n  </article>\n\n  <section id=\"overview\">\n    <div class=\"wrap\">\n      <h2><span class=\"idx\">01</span>服务概览</h2>\n      <p>SIM 的服务结构由三个维度构成：流量配额、并发设备数量、线路与支持等级。不同套餐在这三个维度上呈阶梯差异，不涉及功能锁或隐藏档位。</p>\n      <ul class=\"spec\">\n        <li><span class=\"k\">流量计费方式</span><span class=\"v\">按月配额，超出后限速或暂停，不自动扣费</span></li>\n        <li><span class=\"k\">设备并发</span><span class=\"v\">以同时在线设备数计，不绑定固定设备指纹</span></li>\n        <li><span class=\"k\">线路组成</span><span class=\"v\">普通节点池、原生流媒体节点、IPLC 专线、VIP 高带宽节点</span></li>\n        <li><span class=\"k\">支持渠道</span><span class=\"v\">工单系统为主，旗舰版及以上享受优先队列</span></li>\n        <li><span class=\"k\">支付周期</span><span class=\"v\">月付与年付并存，年付为折扣价而非预付合约</span></li>\n        <li><span class=\"k\">退款政策</span><span class=\"v\">以订阅页面公示条款为准，本页不另作承诺</span></li>\n      </ul>\n    </div>\n  </section>\n\n  <section id=\"plans\">\n    <div class=\"wrap\">\n      <h2><span class=\"idx\">02</span>套餐规格</h2>\n      <p>三档套餐按流量、设备数、线路与支持等级逐级递进。年付价格为折扣后的单年总价，不折算为月费扣减。</p>\n\n      <div class=\"plans\">\n\n        <div class=\"plan\">\n          <div class=\"head\">\n            <div class=\"name\">基础版</div>\n            <div class=\"price\"><strong>¥15/月</strong></div>\n          </div>\n          <div class=\"annual\">按年付仅需 ¥150/年</div>\n          <ul class=\"feat\">\n            <li>每月 100GB 极速流量</li>\n            <li>支持 3 台设备同时在线</li>\n            <li>解锁基础流媒体</li>\n            <li>普通线路节点池</li>\n          </ul>\n        </div>\n\n        <div class=\"plan featured\">\n          <div class=\"head\">\n            <div class=\"name\">旗舰版<span class=\"tag\">推荐</span></div>\n            <div class=\"price\"><strong>¥35/月</strong></div>\n          </div>\n          <div class=\"annual\">按年付仅需 ¥350/年</div>\n          <ul class=\"feat\">\n            <li>每月 300GB 极速流量</li>\n            <li>支持 5 台设备同时在线</li>\n            <li>全节点原生流媒体解锁</li>\n            <li>IPLC 专线游戏加速优化</li>\n            <li>7x24 优先工单支持</li>\n          </ul>\n        </div>\n\n        <div class=\"plan\">\n          <div class=\"head\">\n            <div class=\"name\">团队版</div>\n            <div class=\"price\"><strong>¥85/月</strong></div>\n          </div>\n          <div class=\"annual\">按年付仅需 ¥850/年</div>\n          <ul class=\"feat\">\n            <li>每月 1000GB 极速流量</li>\n            <li>支持 20 台设备同时在线</li>\n            <li>VIP 专属高带宽节点</li>\n            <li>支持企业定制路由</li>\n            <li>专属客户经理服务</li>\n          </ul>\n        </div>\n\n      </div>\n    </div>\n  </section>\n\n  <section id=\"usage\">\n    <div class=\"wrap\">\n      <h2><span class=\"idx\">03</span>使用说明</h2>\n      <p>以下步骤描述从订阅到首次连接的常规路径。若订阅页面或客户端引导与本说明存在差异，以订阅页面实时公示为准。</p>\n      <ol class=\"steps\">\n        <li>\n          <div>\n            <h3>选择套餐并完成订阅</h3>\n            <p>在订阅页面选择月付或年付，完成支付后系统生成订阅链接与账户标识。年付价格已含折扣，无需额外码。</p>\n          </div>\n        </li>\n        <li>\n          <div>\n            <h3>导入订阅到客户端</h3>\n            <p>复制订阅链接，在支持的客户端中选择“导入订阅”或“更新订阅”。首次导入后，节点列表会按线路类型分组显示。</p>\n          </div>\n        </li>\n        <li>\n          <div>\n            <h3>选择线路并建立连接</h3>\n            <p>根据用途选择对应线路：普通浏览使用普通节点池，流媒体使用原生解锁节点，游戏加速使用 IPLC 专线。开启连接后客户端显示当前节点与延迟。</p>\n          </div>\n        </li>\n        <li>\n          <div>\n            <h3>核对流量与设备数</h3>\n            <p>在账户面板查看本月已用流量与在线设备数。设备并发达到上限时，新设备连接会失败，不会自动挤占旧会话。</p>\n          </div>\n        </li>\n        <li>\n          <div>\n            <h3>续订或变更套餐</h3>\n            <p>套餐到期前可在账户面板续订或变更档位。升级后流量与设备数即时生效，降级在下一计费周期生效。</p>\n          </div>\n        </li>\n      </ol>\n    </div>\n  </section>\n\n  <section id=\"clients\">\n    <div class=\"wrap\">\n      <h2><span class=\"idx\">04</span>客户端</h2>\n      <p class=\"intro\">SIM 不限定单一客户端，凡支持对应订阅协议的第三方客户端均可导入使用。以下列出常见平台与导入方式说明，不提供官方下载链接，请通过各平台官方渠道获取客户端。</p>\n      <div class=\"row\">\n        <div class=\"cell\">\n          <h3>Windows</h3>\n          <p>支持导入订阅链接的通用代理客户端均可使用。导入后在系统代理模式下生效。</p>\n          <div class=\"link\"><a href=\"#\">获取方式：客户端官方渠道</a></div>\n        </div>\n        <div class=\"cell\">\n          <h3>macOS</h3>\n          <p>支持订阅导入的客户端适用。部分客户端需在系统设置中单独授予代理权限。</p>\n          <div class=\"link\"><a href=\"#\">获取方式：客户端官方渠道</a></div>\n        </div>\n        <div class=\"cell\">\n          <h3>Android</h3>\n          <p>通过订阅链接导入节点列表，按线路类型选择节点后开启 VPN 权限即可连接。</p>\n          <div class=\"link\"><a href=\"#\">获取方式：客户端官方渠道</a></div>\n        </div>\n        <div class=\"cell\">\n          <h3>iOS</h3>\n          <p>需在 App Store 获取支持订阅导入的客户端，导入后按系统提示授权 VPN 配置。</p>\n          <div class=\"link\"><a href=\"#\">获取方式：客户端官方渠道</a></div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"faq\">\n    <div class=\"wrap\">\n      <h2><span class=\"idx\">05</span>常见问题</h2>\n      <p>以下问题按订阅、使用、支持三类排列。若此处说明与订阅页条款不一致，以订阅页为准。</p>\n      <ol class=\"faq\">\n        <li>\n          <div>\n            <h3>流量配额用尽后会怎样？</h3>\n            <p>套餐流量用尽后，连接将限速或暂停，不会产生自动扣费。可在账户面板单独加购流量包，或等待下一计费周期重置。</p>\n          </div>\n        </li>\n        <li>\n          <div>\n            <h3>设备并发数如何计算？</h3>\n            <p>以同一账户同时在线的设备会话数计算，不绑定固定设备硬件。达到上限后新设备无法连接，需先断开旧会话。</p>\n          </div>\n        </li>\n        <li>\n          <div>\n            <h3>月付与年付之间能否切换？</h3>\n            <p>可以。在账户面板可变更计费周期，切换在当前周期结束后生效；未到期部分不折算退款，按剩余周期顺延。</p>\n          </div>\n        </li>\n        <li>\n          <div>\n            <h3>旗舰版与团队版的线路差异是什么？</h3>\n            <p>旗舰版包含 IPLC 专线与全节点原生流媒体解锁；团队版在旗舰版基础上增加 VIP 高带宽节点与企业定制路由，适合多成员并发场景。</p>\n          </div>\n        </li>\n        <li>\n          <div>\n            <h3>是否支持退款？</h3>\n            <p>退款政策以订阅页面公示条款为准，本页不作另行承诺。一般而言，已使用流量的周期不纳入退款范围。</p>\n          </div>\n        </li>\n        <li>\n          <div>\n            <h3>工单支持如何响应？</h3>\n            <p>基础版工单按普通队列处理；旗舰版享受 7x24 优先队列；团队版由专属客户经理对接，响应时间以服务时段为准。</p>\n          </div>\n        </li>\n        <li>\n          <div>\n            <h3>能否用于企业固定出口？</h3>\n            <p>团队版支持企业定制路由，可与客户经理沟通出口节点与路由策略。基础版与旗舰版不提供定制路由能力。</p>\n          </div>\n        </li>\n      </ol>\n    </div>\n  </section>\n\n</main>\n\n<footer>\n  <div class=\"wrap\">\n    <div class=\"name\">SIM</div>\n    <div class=\"note\">本页为服务说明文档，仅用于在订阅前核对套餐规格、使用方式与支持范围。具体订阅条款、价格与可用性以订阅页面实时公示为准。</div>\n    <div class=\"links\">\n      <a href=\"#overview\">概览</a>\n      <a href=\"#plans\">套餐</a>\n      <a href=\"#usage\">使用说明</a>\n      <a href=\"#clients\">客户端</a>\n      <a href=\"#faq\">常见问题</a>\n    </div>\n    <div class=\"copy\">SIM 服务说明文档 · 仅供查阅</div>\n  </div>\n</footer>",
